<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ubra's wake helper, registered with SMAppService.daemonServiceWithPlistName
  and approved once by an administrator in System Settings > Login Items.
  launchd owns the socket and starts the helper only when the Engine connects;
  the helper exits after 20 seconds idle. See crates/ubra-engine/src/wake.rs.
  SockPathMode 438 is 0666: any local user may connect, and the helper scopes
  every request to the caller's own uid.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ubra.ubra.wake</string>
    <key>BundleProgram</key>
    <string>Contents/Resources/bin/ubra-wake-helper</string>
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>com.ubra.ubra</string>
    </array>
    <key>Sockets</key>
    <dict>
        <key>Listeners</key>
        <dict>
            <key>SockPathName</key>
            <string>/var/run/com.ubra.ubra.wake.sock</string>
            <key>SockPathMode</key>
            <integer>438</integer>
        </dict>
    </dict>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
